{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-perf"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": [
    "packages/app/dist",
    "packages/app/src/routeTree.gen.ts",
    "packages/wasm-core/_build",
    "test-results",
    "playwright-report"
  ]
}
